# Reference only. Nothing in the app reads a .env file — there is no python-dotenv
# here — so these must be EXPORTED into the shell that starts the server:
#
#   export GEMINI_API_KEY=your-key-here
#   uvicorn main:app --reload
#
# Or for a single run:
#
#   GEMINI_API_KEY=your-key-here uvicorn main:app --reload
#
# On Render, set these in the service's Environment tab instead.
# Without GEMINI_API_KEY the app still works: classification falls back to the
# deterministic template path and every issue is marked degraded.

GEMINI_API_KEY=
# Default lives in ai.py; only set this to override it.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional overrides
# GEMINI_TIMEOUT_MS=15000
# REPAIRRECORD_DB=repairrecord.db
# REPAIRRECORD_UPLOADS=uploads
